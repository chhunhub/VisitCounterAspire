@page "/counter"
@rendermode InteractiveServer
@inject IHttpClientFactory Factory

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private long currentCount;
    private HttpClient http = default!;

    protected override async Task OnInitializedAsync()
    {
        http = Factory.CreateClient("api");
        currentCount = await http.GetFromJsonAsync<long>("hits");
    }

    private async Task IncrementCount()
    {
        var response = await http.PostAsync("hit", null);
        currentCount = await response.Content.ReadFromJsonAsync<long>();
    }
}